# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI (required for scoring and language judgment) ---
# The same key covers chat and embeddings. Without it the app still runs: it
# fetches, normalizes, dedups, ranks and stores jobs (using the built-in
# keyless lexical prefilter), and skips every stage that needs a model.
OPENAI_API_KEY=
# Optional: point at a compatible gateway (Azure proxy, LiteLLM, Ollama, ...).
# Safe to leave blank - config.py normalizes a blank to "unset" and passes the
# real API URL explicitly, because the OpenAI SDK reads this variable itself and
# an empty value would make every request fail as "Connection error".
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Adzuna (optional third source; free signup at developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch (optional: Indeed, StepStone, LinkedIn postings via Google for Jobs) ---
# Free key (200 requests/month) from openwebninja.com (JSearch API), then switch
# the source on in Settings. A RapidAPI key works too: set the host to
# jsearch.p.rapidapi.com.
JSEARCH_API_KEY=
JSEARCH_API_HOST=api.openwebninja.com

# --- App ---
# Inside Docker this is overridden to /data/job_portal.db by docker-compose.
DATABASE_URL=sqlite:///./data/job_portal.db
TIMEZONE=Europe/Berlin
# In-process APScheduler timer. Leave on for an always-on host; turn off if you
# drive the daily run from cron / Windows Task Scheduler instead.
ENABLE_SCHEDULER=true
# Catch up on startup if today's run has not happened yet.
CATCH_UP_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
